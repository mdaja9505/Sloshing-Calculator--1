{ "title": "Seismic Design of Liquid-Containing Concrete Structures (ACI 350.3-20)", "summary": "This document specifies the requirements for the seismic analysis and design of liquid-containing concrete structures, including both rectangular and circular tanks. It utilizes a dynamic model that separates the liquid mass into impulsive and convective components and provides formulas for calculating dynamic lateral forces, base shear, and overturning moments. The design procedure accounts for wall and roof inertia, vertical acceleration, and earthquake-induced earth pressures for buried or partially buried tanks.", "key_points": [ "Liquid mass is separated into impulsive (rigidly attached) and convective (sloshing) components for dynamic analysis.", "Dynamic loads are combined using the square-root-sum-of-the-squares (SRSS) method.", "Bending moments are calculated for both Excluding Base Pressure (EBP) and Including Base Pressure (IBP) conditions.", "Vertical acceleration effects must be included in the hydrodynamic pressure calculations.", "The Response Modification Factor (R) and Importance Factor (I) are utilized to adjust design forces based on structure type and risk category." ], "equations": [ { "number": "4.1.1a", "description": "Inertia force of tank wall (Pw)", "formula": "Pw = Ci * I * (epsilon * Ww / Ri)" }, { "number": "4.1.1b", "description": "Inertia force of perpendicular wall (P'w)", "formula": "P'w = Ci * I * (epsilon * W'w / Ri)" }, { "number": "4.1.1c", "description": "Inertia force of tank roof (Pr)", "formula": "Pr = Ci * I * (Wr / Ri)" }, { "number": "4.1.1d", "description": "Hydrodynamic impulsive pressure (Pi)", "formula": "Pi = Ci * I * (Wi / Ri)" }, { "number": "4.1.1e", "description": "Hydrodynamic convective pressure (Pc)", "formula": "Pc = Cc * I * (Wc / Rc)" }, { "number": "4.1.2", "description": "Total horizontal base shear (V)", "formula": "V = sqrt((Pw + Pr + Pi)^2 + Pc^2 + Peg^2)" }, { "number": "4.1.3a", "description": "Wall inertia moment (Mw)", "formula": "Mw = Pw * hw" }, { "number": "4.1.3b", "description": "Roof inertia moment (Mr)", "formula": "Mr = Pr * hr" }, { "number": "4.1.3c", "description": "Impulsive liquid moment (Mi)", "formula": "Mi = Pi * hi" }, { "number": "4.1.3d", "description": "Convective liquid moment (Mc)", "formula": "Mc = Pc * hc" }, { "number": "4.1.3e", "description": "Dynamic earth pressure moment (Meg)", "formula": "Meg = Peg * heg" }, { "number": "4.1.3f", "description": "Combined bending moment at base (Mb)", "formula": "Mb = sqrt((Mi + Mw + Mr)^2 + Mc^2 + Meg^2)" }, { "number": "4.1.3g", "description": "Impulsive overturning moment (M'i)", "formula": "M'i = Pi * h'i" }, { "number": "4.1.3h", "description": "Convective overturning moment (M'c)", "formula": "M'c = Pc * h'c" }, { "number": "4.1.3i", "description": "Total overturning moment (Mo)", "formula": "Mo = sqrt((M'i + Mw + Mr)^2 + M'c^2 + Meg^2)" }, { "number": "4.1.4.2a", "description": "Hydrodynamic pressure due to vertical acceleration (pvy)", "formula": "pvy = üv * qhy" }, { "number": "4.1.4.2b", "description": "Effective vertical spectral acceleration (üv)", "formula": "üv = Ci * I * (b / Ri) >= 0.2 * SDS" }, { "number": "5.3.2", "description": "Combined dynamic force at height y (Rectangular)", "formula": "Py = sqrt((Pw + Pwy)^2 + Piy^2 + (pvy * B)^2)" }, { "number": "6.2a", "description": "Dynamic membrane (hoop) force (Circular)", "formula": "Ny = sqrt((Niy + Nwy)^2 + Ncy^2 + Nhy^2)" }, { "number": "6.2b", "description": "Hoop stress (Circular)", "formula": "sigma_y = Ny / (12 * tw) [in-lb] or Ny / tw [SI]" }, { "number": "7.1a", "description": "Simplified wave oscillation (Rectangular)", "formula": "dmax = (L / 2) * Cc * I" }, { "number": "7.1b", "description": "Detailed wave oscillation (Rectangular)", "formula": "dmax = [0.264L / ((2g / (wc^2 * Cc * L)) - 1) * tanh(3.16HL / L)] * I" }, { "number": "7.1c", "description": "Simplified wave oscillation (Circular)", "formula": "dmax = (D / 2) * Cc * I" }, { "number": "7.1d", "description": "Detailed wave oscillation (Circular)", "formula": "dmax = [0.204D / ((2g / (wc^2 * Cc * D)) - 1) * tanh(3.68HL / D)] * I" }, { "number": "9.2.1a", "description": "Effective impulsive weight (Rectangular)", "formula": "Wi / WL = tanh[0.866(L / HL)] / [0.866(L / HL)]" }, { "number": "9.2.1b", "description": "Effective convective weight (Rectangular)", "formula": "Wc / WL = 0.264(L / HL) * tanh[3.16(HL / L)]" }, { "number": "9.2.2a", "description": "Impulsive center of gravity EBP (L/HL < 1.333)", "formula": "hi / HL = 0.5 - 0.09375(L / HL)" }, { "number": "9.2.2b", "description": "Impulsive center of gravity EBP (L/HL >= 1.333)", "formula": "hi / HL = 0.375" }, { "number": "9.2.2c", "description": "Convective center of gravity EBP (Rectangular)", "formula": "hc / HL = 1 - (cosh[3.16(HL / L)] - 1) / (3.16(HL / L) * sinh[3.16(HL / L)])" }, { "number": "9.2.3a", "description": "Impulsive center of gravity IBP (L/HL < 0.75)", "formula": "h'i / HL = 0.45" }, { "number": "9.2.3b", "description": "Impulsive center of gravity IBP (L/HL >= 0.75)", "formula": "h'i / HL = [0.866(L / HL) / (2 * tanh[0.866(L / HL)])] - 0.125" }, { "number": "9.2.3c", "description": "Convective center of gravity IBP (Rectangular)", "formula": "h'c / HL = 1 - (cosh[3.16(HL / L)] - 2.01) / (3.16(HL / L) * sinh[3.16(HL / L)])" }, { "number": "9.2.4a", "description": "Impulsive natural frequency (Rectangular)", "formula": "wi = sqrt(k / m)" }, { "number": "9.2.4b", "description": "Effective mass (Rectangular)", "formula": "m = mw + mi" }, { "number": "9.2.4c", "description": "Impulsive period (Rectangular)", "formula": "Ti = 2pi / wi = 2pi * sqrt(m / k)" }, { "number": "9.2.4d", "description": "Convective frequency (Rectangular)", "formula": "wc = lambda / sqrt(L)" }, { "number": "9.2.4e", "description": "Convective coefficient lambda (Rectangular)", "formula": "lambda = sqrt(3.16g * tanh[3.16(HL / L)])" }, { "number": "9.2.4f", "description": "Convective period (Rectangular)", "formula": "Tc = (2pi / lambda) * sqrt(L)" },{ "number": "9.3.1a", "description": "Effective impulsive weight (Circular)", "formula": "Wi / WL = tanh[0.866(D / HL)] / [0.866(D / HL)]" },{ "number": "9.3.1b", "description": "Effective convective weight (Circular)", "formula": "Wc / WL = 0.230(D / HL) * tanh[3.68(HL / D)]" },{ "number": "9.3.2a", "description": "Impulsive center of gravity EBP (D/HL < 1.333)", "formula": "hi / HL = 0.5 - 0.09375(D / HL)" },{ "number": "9.3.2b", "description": "Impulsive center of gravity EBP (D/HL >= 1.333)", "formula": "hi / HL = 0.375" },{ "number": "9.3.2c", "description": "Convective center of gravity EBP (Circular)", "formula": "hc / HL = 1 - (cosh[3.68(HL / D)] - 1) / (3.68(HL / D) * sinh[3.68(HL / D)])" },{ "number": "9.3.3a", "description": "Impulsive center of gravity IBP (D/HL < 0.75)", "formula": "h'i / HL = 0.45" },{ "number": "9.3.3b", "description": "Impulsive center of gravity IBP (D/HL >= 0.75)", "formula": "h'i / HL = [0.866(D / HL) / (2 * tanh[0.866(D / HL)])] - 0.125" },{ "number": "9.3.3c", "description": "Convective center of gravity IBP (Circular)", "formula": "h'c / HL = 1 - (cosh[3.68(HL / D)] - 2.01) / (3.68(HL / D) * sinh[3.68(HL / D)])" },{ "number": "9.3.4a", "description": "Impulsive frequency (Circular)", "formula": "wi = Ci * sqrt(12/HL * Ecg/gamma_c) [in-lb]" }, { "number": "9.3.4b", "description": "Frequency coefficient Ci (Circular)", "formula": "Ci = Cw * 10 * sqrt(tw / 12r) [in-lb]" }, { "number": "9.3.4c", "description": "Impulsive period (Circular)", "formula": "Ti = 2pi / wi" },{ "number": "9.3.4d", "description": "Impulsive period (Flexible base Type 2.3)", "formula": "Ti = sqrt(8pi(Ww + Wr + Wi) / (g * D * ka))" }, { "number": "9.3.4e", "description": "Base spring constant ka", "formula": "ka = 144 * [(AsEscos^2(alpha) / (LcSc)) + (2GpwpLp / (tpSp))]" },{ "number": "9.3.4f", "description": "Convective frequency (Circular)", "formula": "wc = lambda / sqrt(D)" },{ "number": "9.3.4g", "description": "Convective coefficient lambda (Circular)", "formula": "lambda = sqrt(3.68g * tanh[3.68(HL / D)])" },{ "number": "9.3.4h", "description": "Convective period (Circular)", "formula": "Tc = (2pi / lambda) * sqrt(D)" }, { "number": "9.4.1a", "description": "Impulsive coefficient Ci (Ti <= Ts)", "formula": "Ci = SDS" }, { "number": "9.4.1b", "description": "Impulsive coefficient Ci (Ti > Ts)", "formula": "Ci = SD1 / Ti <= SDS" }, { "number": "9.4.1c", "description": "Characteristic period Ts", "formula": "Ts = SD1 / SDS" }, { "number": "9.4.1d", "description": "Design spectral acceleration SDS", "formula": "SDS = 2/3 * Ss * Fa" }, { "number": "9.4.1e", "description": "Design spectral acceleration SD1", "formula": "SD1 = 2/3 * S1 * Fv" }, { "number": "9.4.2a", "description": "Convective coefficient Cc (Tc <= TL)", "formula": "Cc = 1.5 * SD1 / Tc <= 1.5 * SDS" }, { "number": "9.4.2b", "description": "Convective coefficient Cc (Tc > TL)", "formula": "Cc = 1.5 * SD1 * TL / Tc^2" }, { "number": "9.4.3a", "description": "Circular impulsive response coefficient", "formula": "Ci = SDS" }, { "number": "9.4.3b", "description": "Rectangular impulsive response coefficient", "formula": "Ci = Ci (calculated)" }, { "number": "9.5a", "description": "Site-specific impulsive coefficient Ci", "formula": "Ci = 2/3 * SaM" }, { "number": "9.5b", "description": "Site-specific convective coefficient Cc", "formula": "Cc = 2/3 * ScM" }, { "number": "9.5c", "description": "Site-specific vertical coefficient Ci", "formula": "Ci = 2/3 * SvM" }, { "number": "9.6.1", "description": "Effective mass coefficient epsilon (Rectangular)", "formula": "epsilon = [0.0151(L/HL)^2 - 0.1908(L/HL) + 1.021] <= 1.0" }, { "number": "9.6.2", "description": "Effective mass coefficient epsilon (Circular)", "formula": "epsilon = [0.0151(D/HL)^2 - 0.1908(D/HL) + 1.021] <= 1.0" }, { "number": "R8.1a", "description": "Dynamic earth pressure (Yielding, dry)", "formula": "Peg = (3/8)(SDS/2.5) * gamma * H^2 * (I/R)" }, { "number": "R8.1b", "description": "Dynamic earth pressure (Non-yielding, dry)", "formula": "Peg = (SDS/2.5) * gamma * H^2 * (I/R)" }, { "number": "R8.1c", "description": "Dynamic earth pressure (Yielding, groundwater)", "formula": "Peg = (3/8)khw * (SDS/2.5) * gamma * H^2 * (I/R)" }, { "number": "R8.1d", "description": "Dynamic earth pressure (Non-yielding, groundwater)", "formula": "Peg = khw * (SDS/2.5) * gamma * H^2 * (I/R)" }, { "number": "R8.1e", "description": "Groundwater coefficient khw", "formula": "khw = gamma_s / gamma_b" } ], "faq": [ { "question": "What is the difference between EBP and IBP?", "answer": "EBP (Excluding Base Pressure) is used for designing the wall-to-base joint and wall section, while IBP (Including Base Pressure) accounts for the hydrodynamic pressure on the floor to assess the global overturning stability of the entire structure." }, { "question": "When should vertical acceleration be considered?", "answer": "Vertical acceleration effects should always be included in the design unless a site-specific response spectrum indicates otherwise. It is calculated by multiplying the hydrostatic load by a spectral acceleration factor (üv)." }, { "question": "How are impulsive and convective components combined?", "answer": "They are combined using the square-root-sum-of-the-squares (SRSS) method because these two components are generally out of phase with each other." } ] }